{
  "StartAt": "IngestFromYouTubeAPI",
  "States": {
    "IngestFromYouTubeAPI": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:ap-south-1:654654557613:function:youtube-data-pipeline-ingestion:$LATEST",
        "Payload": {
          "triggered_by": "step_functions",
          "execution_id": "{% $states.context.Execution.Id %}"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "BackoffRate": 2,
          "JitterStrategy": "FULL",
          "IntervalSeconds": 60,
          "MaxAttempts": 2
        }
      ],
      "Next": "WaitForS3Consistency",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "NotifyIngestionFailure",
          "Output": "{% $merge([$states.input, {'error': $states.errorOutput}]) %}"
        }
      ],
      "Output": "{% $merge([$states.input, {'ingestion_result': $states.result.Payload}]) %}"
    },
    "NotifyIngestionFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "arn:aws:sns:ap-south-1:654654557613:youtube-data-pipeline-alerts-dev",
        "Subject": "[YouTube Pipeline] FAILURE — Ingestion step failed",
        "Message": "{% $string($states.input.error) %}"
      },
      "End": true
    },
    "WaitForS3Consistency": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "Parallel"
    },
    "Parallel": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "TransformReferenceData",
          "States": {
            "TransformReferenceData": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Arguments": {
                "Payload": {
                  "triggered_by": "step_functions"
                },
                "FunctionName": "arn:aws:lambda:ap-south-1:654654557613:function:youtube-data-pipeline-json-to-parquet-dev:$LATEST"
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 15,
                  "BackoffRate": 2,
                  "JitterStrategy": "FULL",
                  "MaxAttempts": 2
                }
              ],
              "End": true,
              "Output": "{% $merge([$states.input, {'reference_result': $states.result.Payload}]) %}"
            }
          }
        },
        {
          "StartAt": "RunBronzeToSilverGlueJob",
          "States": {
            "RunBronzeToSilverGlueJob": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Arguments": {
                "JobName": "youtube-data-pipeline-bronze-to-silver",
                "Arguments": {
                  "--bronze_database": "youtube_data_pipeline_bronze",
                  "--bronze_table": "raw_statistics",
                  "--silver_bucket": "youtube-data-pipeline-silver-dev-76",
                  "--silver_database": "youtube_data_pipeline_silver",
                  "--silver_table": "clean_statistics"
                }
              },
              "End": true,
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "BackoffRate": 2,
                  "IntervalSeconds": 15,
                  "MaxAttempts": 3
                }
              ],
              "Output": "{% $merge([$states.input, {'glue_bronze_silver_result': $states.result}]) %}"
            }
          }
        }
      ],
      "Next": "RunDataQualityChecks",
      "Output": "{% $merge([$states.input, {'parallel_results': $states.result}]) %}",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "NotifyTransformFailure",
          "Output": "{% $merge([$states.input, {'error': $states.errorOutput}]) %}"
        }
      ]
    },
    "NotifyTransformFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "arn:aws:sns:ap-south-1:654654557613:youtube-data-pipeline-alerts-dev",
        "Subject": "[YouTube Pipeline] FAILURE — Transform step failed",
        "Message": "{% $string($states.input.error) %}"
      },
      "End": true
    },
    "RunDataQualityChecks": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:ap-south-1:654654557613:function:youtube-data-pipeline-data-quality:$LATEST",
        "Payload": {
          "layer": "silver",
          "database": "youtube_data_pipeline_silver",
          "tables": [
            "clean_statistics",
            "clean_reference_data"
          ]
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "EvaluteDataQuality",
      "Output": "{% $merge([$states.input, {'dq_result': $states.result.Payload}]) %}"
    },
    "EvaluteDataQuality": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "RunSilverToGoldGlueJob",
          "Condition": "{% $states.input.dq_result.quality_passed = true %}"
        }
      ],
      "Default": "NotifyDQFailure"
    },
    "RunSilverToGoldGlueJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Arguments": {
        "JobName": "youtube-data-pepeline-silver-to-gold",
        "Arguments": {
          "--silver_database": "youtube_data_pipeline_silver",
          "--gold_bucket": "youtube-data-pipeline-gold-dev-76",
          "--gold_database": "youtube_data_pipeline_gold"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "BackoffRate": 2,
          "MaxAttempts": 3,
          "IntervalSeconds": 15
        }
      ],
      "Output": "{% $merge([$states.input, {'glue_gold_result': $states.result}]) %}",
      "Next": "NotifySuccess",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "NotifyGoldFailure",
          "Output": "{% $merge([$states.input, {'error': $states.errorOutput}]) %}"
        }
      ]
    },
    "NotifyGoldFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "arn:aws:sns:ap-south-1:654654557613:youtube-data-pipeline-alerts-dev",
        "Subject": "[YouTube Pipeline] FAILURE — Gold aggregation failed",
        "Message": "{% $string($states.input.error) %}"
      },
      "End": true
    },
    "NotifySuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "arn:aws:sns:ap-south-1:654654557613:youtube-data-pipeline-alerts-dev",
        "Subject": "[YouTube Pipeline] Pipeline completed successfully",
        "Message": "{% 'Pipeline run ' & $states.context.Execution.Id & ' completed. All layers updated.' %}"
      },
      "End": true
    },
    "NotifyDQFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Arguments": {
        "TopicArn": "arn:aws:sns:ap-south-1:654654557613:youtube-data-pipeline-alerts-dev",
        "Subject": "[YouTube Pipeline] WARNING — Data quality checks failed",
        "Message": "{% $string($states.input.dq_result) %}"
      },
      "End": true
    }
  },
  "QueryLanguage": "JSONata",
  "Comment": "YouTube Data Pipeline — Full orchestration via Step Functions. Replaces manual execution of individual jobs."
}